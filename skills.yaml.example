# Skills manifest — all sources declared here
# Run `setup.sh` or `skillgenie sync` to sync everything to ~/.agents/skills/
#
# Copy this file to `skills.yaml` and edit it. The real `skills.yaml` is
# gitignored: it is your personal manifest and may point at private repos.
# Only this example, which lists public sources, is tracked.

# Local skills: all dirs with SKILL.md in this repo are auto-included.

# Third-party skills — two forms:
#   repo: owner/name   → cloned to ~/.local/share/skill-genie-remotes/, pulled on sync
#   local: /abs/path   → use an existing checkout directly (no clone, no duplicate)
remote:
  - repo: mattpocock/skills
    path: skills
    pick:
      - misc/git-guardrails-claude-code
      - misc/migrate-to-shoehorn
      - misc/scaffold-exercises
      - misc/setup-pre-commit
      - engineering/diagnosing-bugs
      - engineering/tdd
      - productivity/grill-me

  - repo: warpdotdev/oz-skills
    path: .agents/skills
    pick:
      - analysis-artifacts
      - ci-fix
      - create-pull-request
      - dbt-model-index
      - docs-update
      - github-bug-report-triage
      - github-issue-dedupe
      - scheduler
      - seo-aeo-audit
      - slack-qa-investigate
      - terraform-style-check
      - web-accessibility-audit
      - web-performance-audit

  - repo: nextlevelbuilder/ui-ux-pro-max-skill
    path: .claude/skills
    pick:
      - ui-ux-pro-max

  # Not a standard skills/ layout — the skill lives at the repo root, so no `path`
  - repo: tt-a1i/archify
    pick:
      - archify

  # TypeSafe official skill
  - repo: typesafe-ai/skills
    path: skills
    pick:
      - typesafe-ai

  # Cloudflare official skills
  - repo: cloudflare/skills
    path: skills
    pick:
      - cloudflare
      - cloudflare-email-service
      - cloudflare-one
      - cloudflare-one-migrations
      - turnstile-spin
      - agents-sdk
      - durable-objects
      - wrangler
      - workers-best-practices
      - web-perf

  # Cloudflare official security audit skill (separate repo)
  - repo: cloudflare/security-audit-skill
    path: skills
    pick:
      - security-audit

# Private repos go in your own skills.yaml, never here. A private entry looks
# the same as a public one; the clone uses your `gh` git credentials.

# Optional: only installed if the tool is detected on this machine
optional:
  - tool: trellis
    source: npm:@mindfoldhq/trellis/dist/templates/codex/skills
    pick:
      - start
      - brainstorm
      - check
      - check-cross-layer
      - update-spec
      - before-dev
      - break-loop
      - finish-work

# Bundled skills (installed via registry, managed by .bundled_manifest)
# These are auto-installed and not tracked in this manifest.
# To reset: setup.sh --full will clear and reinstall from this file only.
